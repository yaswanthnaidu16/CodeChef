#Traverse the binary string in pairs of 2 and replace each pair using the given DNA mapping rules

for _ in range(int(input())):
    n = int(input())
    s = input()

    ans = ""

    for i in range(0, n, 2):
        pair = s[i:i+2]
        if pair == "00":
            ans += "A"
        elif pair == "01":
            ans += "T"
        elif pair == "10":
            ans += "C"
        else:
            ans += "G"

    print(ans)
