#Streak increases when both Chef and Chefina send at least one snap on the same day; otherwise, it resets to zero

for _ in range(int(input())):
    a = int(input())
    x = list(map(int, input().split()))
    y = list(map(int, input().split()))
    count = 0
    ans = 0
    for i in range(a):
        if x[i] > 0 and y[i] > 0:
            count +=1
            ans = max(ans, count)
        else:
            count = 0
    print(ans)
