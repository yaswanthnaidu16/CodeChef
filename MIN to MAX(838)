#Counts how many elements are greater than the minimum value, since those elements must be changed to make the minimum the maximum

for _ in range(int(input())):
    n = int(input())
    a = list(map(int, input().split()))

    m = min(a)
    count = 0

    for i in a:
        if i > m:
            count += 1

    print(count)
